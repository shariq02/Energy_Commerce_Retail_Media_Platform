# ====================================================================
# Energy Commerce & Retail Media Analytics Platform - Environment Variables
# ====================================================================
# NEVER commit .env to Git - it is in .gitignore
# Copy this file to .env and fill in real values
# ====================================================================

# ====================================================================
# PROJECT
# ====================================================================

PROJECT_NAME=energy-commerce-retail-media-platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# ====================================================================
# POSTGRESQL DATABASE (operational system)
# ====================================================================

POSTGRES_HOST=
POSTGRES_PORT=****
POSTGRES_DB=ecrmap
POSTGRES_USER=username
POSTGRES_PASSWORD=

# ====================================================================
# KAFKA (REDPANDA)
# ====================================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:****
KAFKA_CLIENT_ID=ecrmap-producer
KAFKA_COMPRESSION_TYPE=gzip
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=10
KAFKA_BUFFER_MEMORY=33554432
KAFKA_MAX_IN_FLIGHT=5

# ====================================================================
# KAFKA TOPICS
# ====================================================================

TOPIC_MARKET=market.events
TOPIC_WEATHER=weather.events
TOPIC_IOT=iot.consumption
TOPIC_COMMERCE=commerce.events
TOPIC_RETAIL_MEDIA=retailmedia.events
TOPIC_CDC_OPERATIONAL=cdc.operational

# ====================================================================
# GCP CREDENTIALS
# Fill in from the service account key downloaded when creating the
# project's IAM service account
# ====================================================================

GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_REGION=europe-west3
GCP_BILLING_ACCOUNT_ID=

# ====================================================================
# GOOGLE CLOUD STORAGE
# Buckets provisioned by Terraform
# ====================================================================

GCS_RAW_BUCKET=ecrmap-dev-raw
GCS_STAGED_BUCKET=ecrmap-dev-staged

# ====================================================================
# BIGQUERY
# Datasets provisioned by Terraform
# Sandbox vs bounded-cost operating mode applies here
# ====================================================================

BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_RAW=ecrmap_raw
BIGQUERY_DATASET_STAGING=ecrmap_staging
BIGQUERY_DATASET_CORE=ecrmap_core
BIGQUERY_DATASET_MARTS=ecrmap_marts
BIGQUERY_DATASET_SEMANTIC=ecrmap_semantic

# ====================================================================
# CDC / DEBEZIUM
# ====================================================================

DEBEZIUM_CONNECTOR_NAME=ecrmap-postgres-connector
DEBEZIUM_SLOT_NAME=ecrmap_slot
DEBEZIUM_TOPIC_PREFIX=cdc

# ====================================================================
# APACHE FLINK — not used in this project
# (Databricks/PySpark handles streaming and batch processing instead)
# ====================================================================

# ====================================================================
# DATABRICKS
# ====================================================================

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_TOKEN_DBT=

# ====================================================================
# DAGSTER
# ====================================================================

DAGSTER_HOME=

# ====================================================================
# DBT
# ====================================================================

DBT_PROFILES_DIR=

# ====================================================================
# FASTAPI (AI agent service layer only)
# ====================================================================

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=****
FASTAPI_RELOAD=true

# ====================================================================
# AI / LLM / RAG
# ====================================================================

LLM_API_KEY=
LLM_MODEL=
CHROMA_DB_PATH=./ai/vector_store/data

# ====================================================================
# DATA GENERATOR (synthetic operational data)
# ====================================================================

GENERATOR_EVENTS_PER_SECOND=10
GENERATOR_REPLAY_SPEED=60
GENERATOR_ANOMALY_MODE=false
GENERATOR_ANOMALY_PROBABILITY=0.05

# ====================================================================
# GRAFANA
# ====================================================================

GRAFANA_HOST=localhost
GRAFANA_PORT=****
GRAFANA_USER=username
GRAFANA_PASSWORD=*******
