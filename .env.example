# ====================================================================
# ECRMAP - Ecosystem-Centric Real-World Multi-Domain Analytics Platform - Environment Variables
# ====================================================================
# NEVER commit .env to Git - it is in .gitignore
# Copy this file to .env and fill in real values
# ====================================================================

# ====================================================================
# PROJECT
# ====================================================================

PROJECT_NAME=ecrmap
ENVIRONMENT=development
LOG_LEVEL=INFO

# Stops Python writing __pycache__ / *.pyc. Read by the interpreter at
# startup, so it only takes effect when exported in your shell -- e.g.
# `set -a; source .env` or add it to ~/.bashrc. (The ruff cache is moved
# out of the tree in pyproject.toml; the pytest cache is off in pytest.ini.)
PYTHONDONTWRITEBYTECODE=1

# ====================================================================
# POSTGRESQL SERVING DATABASE
# Read-only BI serving store, loaded from Databricks via a local export.
# Not yet provisioned -- see postgres/serving/00_bootstrap_serving.sql.
# ====================================================================

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ecrmap_serving
POSTGRES_USER=username
POSTGRES_PASSWORD=

# ====================================================================
# GCP CREDENTIALS
# Fill in from the service account key downloaded when creating the
# project's IAM service account
# ====================================================================

GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_REGION=europe-west3
GCP_BILLING_ACCOUNT_ID=

# ====================================================================
# BIGQUERY -- Google-source acquisition interface only
# One acquisition dataset, provisioned by Terraform. GA4 is its first source.
# ====================================================================

BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ACQUISITION=ecrmap_acquisition

# ====================================================================
# DATABRICKS
# ====================================================================

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=energy_commerce_retail_media

# ====================================================================
# FASTAPI (AI agent service layer only)
# ====================================================================

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=****
FASTAPI_RELOAD=true

# ====================================================================
# AI / LLM / RAG
# ====================================================================

LLM_API_KEY=
LLM_MODEL=
CHROMA_DB_PATH=./ai/vector_store/data

# ====================================================================
# GRAFANA
# ====================================================================

GRAFANA_HOST=localhost
GRAFANA_PORT=****
GRAFANA_USER=username
GRAFANA_PASSWORD=*******
